# PLANTILLA DE CONFIGURACIÓN DEL EBR
# Copie este archivo como .env en cada equipo (PC, PRUEBAS, servidor) y complete
# los valores de ESE equipo. El .env real NO se sube a Git (está en .gitignore).
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env

APP_NAME="DEMO EBR Yobel P&G - PRUEBAS"
APP_ENV=development
# En el servidor: APP_ENV=production y DEBUG=False
DEBUG=True
SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_LARGA_Y_UNICA

# Conexión a PostgreSQL de ESTE equipo
# Formato: postgresql+psycopg://USUARIO:CLAVE@SERVIDOR:PUERTO/NOMBRE_BASE
# Si la clave tiene @ : / # escríbalos codificados (por ejemplo @ = %40)
DATABASE_URL=postgresql+psycopg://USUARIO:CLAVE@localhost:5432/ebr_pruebas_db

# Configuración OTP (vigencia del token en segundos)
OTP_EXPIRATION_SECONDS=60

# Sesiones (use una clave distinta en cada entorno)
JWT_SECRET_KEY=CAMBIAR_POR_OTRA_CLAVE_LARGA_Y_UNICA
JWT_EXPIRACION_MINUTOS=30
